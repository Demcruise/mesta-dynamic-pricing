{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": { "config": "", "css": "app/globals.css", "baseColor": "neutral", "cssVariables": true },
  "aliases": { "components": "@/components", "utils": "@/lib/utils", "ui": "@/components/ui", "lib": "@/lib", "hooks": "@/lib/hooks" },
  "iconLibrary": "lucide",
  "registries": {
    "@reactbits-pro": {
      "url": "https://pro.reactbits.dev/r/{name}.json",
      "headers": { "Authorization": "Bearer ${REACTBITS_PRO_TOKEN}" }
    }
  }
}
