  "section": {
    "preferences": {
      "title": "Preferences",
      "desc": "How Mesta looks and formats data for you. Saved automatically."
    },
    "notifications": {
      "title": "Notifications",
      "desc": "Your personal delivery for each notification type. Mandatory alerts set by admins cannot be muted."
    },
    "views": {
      "title": "My views",
      "desc": "Table views you saved across Mesta — filters, columns, sorting and density."
    },
    "general": {
      "title": "General",
      "desc": "Workspace identity, ownership and support contact."
    },
    "scope-hierarchy": {
      "title": "Scope & hierarchy",
      "desc": "The business hierarchy every pricing surface filters by, and the scope users start in."
    },
    "pricing-engine": {
      "title": "Pricing engine",
      "desc": "Price calculation, rounding, freshness windows and how the engine behaves when inputs are missing."
    },
    "integrations": {
      "title": "Data & integrations",
      "desc": "Connected systems, freshness policies and the authoritative source for each field."
    },
    "approvals": {
      "title": "Approval policies",
      "desc": "Who approves which price changes, how fast, and which duties must stay separated."
    },
    "guardrails": {
      "title": "Guardrail defaults",
      "desc": "Workspace-wide defaults that strategies and SKUs inherit unless they override them."
    },
    "workflow": {
      "title": "Workflow defaults",
      "desc": "Defaults for recommendations, simulations and experiments."
    },
    "alerts": {
      "title": "Alerts & routing",
      "desc": "Which events notify whom, on which channels. Critical events can be made mandatory."
    },
    "roles": {
      "title": "Roles & permissions",
      "desc": "Role-based access: what each role may do across Mesta."
    },
    "audit": {
      "title": "Audit & retention",
      "desc": "How long audit events are kept, who may export them, and which events are captured."
    },
    "api": {
      "title": "API & access",
      "desc": "API keys, service accounts and webhook credentials. Secrets are never displayed."
    },
    "security": {
      "title": "Security",
      "desc": "Sessions, sign-in and re-authentication for sensitive actions."
    },
    "features": {
      "title": "Feature controls",
      "desc": "Turn product capabilities on or off for this workspace. Each shows what it depends on."
    }
  },
